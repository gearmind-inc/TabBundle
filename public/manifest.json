{
  "manifest_version": 3,
  "name": "TabBundle",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabBundle",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["tabs", "bookmarks", "storage", "alarms", "contextMenus", "scripting", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
