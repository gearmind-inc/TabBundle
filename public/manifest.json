{
  "manifest_version": 3,
  "name": "TabBundle",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabBundle"
  },
  "permissions": ["tabs", "bookmarks", "storage", "alarms", "contextMenus", "scripting", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
